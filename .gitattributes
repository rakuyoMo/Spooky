# 解析夹具是 Git 的原样输出，行首的空格与制表符都是数据，不做空白检查。
Tests/SpookyKitTests/Fixtures/** -whitespace

# 官网截图存进 Git LFS，仓库历史里只留指针。
website/src/assets/screenshots/** filter=lfs diff=lfs merge=lfs -text

# 宣传片的图片与字体存进 Git LFS，仓库历史里只留指针。
artifacts/promo/**/*.png filter=lfs diff=lfs merge=lfs -text
artifacts/promo/**/*.ttf filter=lfs diff=lfs merge=lfs -text
