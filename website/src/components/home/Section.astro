---
/**
 * 首页的一段：上方是小标题、标题与导语，下面是这一段的内容。
 */

/** 组件的参数。 */
interface Props {
    /** 段落的锚点 */
    id?: string;

    /** 标题上方的小标题，说明这一段讲什么 */
    kicker: string;

    /** 段落标题 */
    title: string;

    /** 标题下的导语 */
    lead?: string;
}

const { id, kicker, title, lead } = Astro.props;
---

<section class="section not-content" id={id}>
    <div class="container">
        <header class="section-header">
            <p class="kicker">{kicker}</p>
            <h2>{title}</h2>
            {lead && <p class="lead">{lead}</p>}
        </header>

        <slot />
    </div>
</section>

<style>
    .section {
        margin: 0;
        padding-block: clamp(4.5rem, 10vw, 8rem);
    }

    .container {
        max-width: 72rem;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    }

    .section-header {
        max-width: 46rem;
        margin: 0 auto clamp(2.5rem, 6vw, 4rem);
        text-align: center;
    }

    .kicker {
        color: var(--sl-color-text-accent);
        font-size: var(--sl-text-sm);
        font-weight: 650;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    /* 中日韩文的小标题不转大写，夹在里面的英文词保持原样 */
    .kicker:is(:lang(zh), :lang(ja), :lang(ko)) {
        letter-spacing: 0.1em;
        text-transform: none;
    }

    h2 {
        margin-top: 0.75rem;
        color: var(--sl-color-white);
        font-size: clamp(2rem, 4.6vw, 3.25rem);
        font-weight: 720;
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    h2:is(:lang(zh), :lang(ja), :lang(ko)) {
        line-height: 1.3;
        letter-spacing: 0;
    }

    .lead {
        margin-top: 1.25rem;
        color: var(--sl-color-gray-2);
        font-size: clamp(var(--sl-text-base), 1.8vw, var(--sl-text-lg));
        line-height: 1.7;
    }
</style>
